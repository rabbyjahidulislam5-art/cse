# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@your-neon-host.neon.tech/smart_campus?sslmode=require

# JWT
JWT_SECRET=change-this-to-a-random-secure-string

# Google Sign-In (Google Cloud Console > APIs & Services > Credentials > OAuth Client ID > Web application)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# SSLCommerz
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password
SSLCOMMERZ_IS_LIVE=false

# Email (Gmail API over OAuth2/HTTPS — NOT SMTP). Render's free web-service tier blocks all
# outbound traffic to SMTP ports 25/465/587, so raw SMTP (any provider) cannot work from here;
# the Gmail REST API sends over HTTPS (443) instead, using this real Gmail account.
# One-time setup: enable the Gmail API + create a "Desktop app" OAuth Client ID in Google Cloud
# Console, then run `npx tsx src/get-gmail-token.ts <CLIENT_ID> <CLIENT_SECRET>` locally to mint
# GMAIL_OAUTH_REFRESH_TOKEN (see server/src/lib/email.ts for details).
GMAIL_SENDER_ADDRESS=your-email@gmail.com
GMAIL_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=your-client-secret
GMAIL_OAUTH_REFRESH_TOKEN=your-refresh-token

# URLs
FRONTEND_URL=https://your-vercel-app.vercel.app
BACKEND_URL=https://your-render-app.onrender.com
PORT=4000
