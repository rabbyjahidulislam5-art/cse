generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  fullName         String?
  email            String    @unique
  password         String?
  role             String    @default("Student")
  studentId        String?   @unique
  department       String?
  batch            String?
  phone            String?
  status           String    @default("Active")
  pinHash          String?
  pinSalt          String?
  pinSet           Boolean   @default(false)
  pinLength        Int       @default(4)
  pinAttempts      Int       @default(0)
  pinLockedUntil   DateTime?
  pinVerifiedAt    DateTime?
  lastLogin        DateTime?
  profilePicture   String?
  emergencyContact String?
  address          String?
  bloodGroup       String?
  gender           String?
  dateOfBirth      String?
  bio              String?
  authProvider     String    @default("password")
  googleId         String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  wallets       Wallet[]
  transactions  Transaction[]
  semesterFees  SemesterFee[]
  libraryFines  LibraryFine[]
  adminFines    AdminFine[]
  payLaterDues  PayLaterDue[]
  otpCodes      OtpCode[]
  auditLogs     AuditLog[]
}

model Wallet {
  id                 String    @id @default(cuid())
  walletId           String    @unique
  owner              User      @relation(fields: [ownerId], references: [id])
  ownerId            String
  balance            Float     @default(0)
  dailyTransferLimit Float     @default(10000)
  dailyTransferred   Float     @default(0)
  lastTransferDate   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Transaction {
  id             String    @id @default(cuid())
  reference      String    @unique
  user           User      @relation(fields: [userId], references: [id])
  userId         String
  type           String
  direction      String
  amount         Float
  serviceCharge  Float?    @default(0)
  status         String    @default("Pending")
  shop           Shop?     @relation(fields: [shopId], references: [id])
  shopId         String?
  gateway        String?
  gatewayTxnId   String?
  bankTxnId      String?
  idempotencyKey String?
  description    String?
  paymentMethod  String?
  purpose        String?
  itemsJson      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  callbacks      PaymentCallback[]
}

model PaymentCallback {
  id            String       @id @default(cuid())
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  transactionId String?
  reference     String
  source        String
  rawPayload    String
  sslStatus     String?
  verified      Boolean      @default(false)
  ipAddress     String?
  createdAt     DateTime     @default(now())
}

model Shop {
  id           String    @id @default(cuid())
  name         String
  category     String
  rating       Float     @default(0)
  status       String    @default("Active")
  qrToken      String?
  qrSignature  String?
  location     String?
  logoUrl      String?
  merchantId   String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  transactions Transaction[]
  payLaterDues PayLaterDue[]
  settlements  Settlement[]
}

// Records a manual internal reconciliation — Admin Office confirming a shop's collected
// SSLCommerz revenue has been paid out to that shop outside the app. SSLCommerz doesn't expose
// an API for actual bank disbursement, so this is bookkeeping, not automatic — every row here
// IS the settlement history (append-only, never edited), so no separate history table is needed.
model Settlement {
  id        String   @id @default(cuid())
  shop      Shop     @relation(fields: [shopId], references: [id])
  shopId    String
  amount    Float
  notes     String?
  settledBy String?
  settledAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model SemesterFee {
  id        String    @id @default(cuid())
  label     String?
  student   User      @relation(fields: [studentId], references: [id])
  studentId String
  amount    Float
  dueDate   String?
  status    String    @default("Pending")
  reference String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model LibraryFine {
  id        String    @id @default(cuid())
  label     String?
  student   User      @relation(fields: [studentId], references: [id])
  studentId String
  fineType  String?
  amount    Float
  dueDate   String?
  status    String    @default("Pending")
  reference String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AdminFine {
  id           String    @id @default(cuid())
  reason       String?
  student      User      @relation(fields: [studentId], references: [id])
  studentId    String
  amount       Float
  incidentDate String?
  status       String    @default("Pending")
  reference    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PayLaterDue {
  id               String    @id @default(cuid())
  reference        String?
  student          User      @relation(fields: [studentId], references: [id])
  studentId        String
  shop             Shop      @relation(fields: [shopId], references: [id])
  shopId           String
  amount           Float
  status           String    @default("Pending")
  dueDate          String?
  description      String?
  paymentReference String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model OtpCode {
  id        String    @id @default(cuid())
  code      String
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?
  purpose   String
  status    String    @default("Active")
  attempts  Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AuditLog {
  id         String    @id @default(cuid())
  action     String
  actor      User?     @relation(fields: [actorId], references: [id])
  actorId    String?
  entityType String?
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
}
