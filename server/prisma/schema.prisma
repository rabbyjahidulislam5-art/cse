generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  fullName           String?
  email              String    @unique
  password           String?
  role               String    @default("Student")
  studentId          String?   @unique
  department         String?
  batch              String?
  phone              String?
  status             String    @default("Active")
  pinHash            String?
  pinSalt            String?
  pinSet             Boolean   @default(false)
  pinLength          Int       @default(4)
  pinAttempts        Int       @default(0)
  pinLockedUntil     DateTime?
  pinVerifiedAt      DateTime?
  lastLogin          DateTime?
  profilePicture     String?
  emergencyContact   String?
  address            String?
  bloodGroup         String?
  gender             String?
  dateOfBirth        String?
  bio                String?
  authProvider       String    @default("password")
  googleId           String?   @unique
  flagged            Boolean   @default(false)
  flagReason         String?
  mustChangePassword Boolean   @default(false)
  emailVerified      Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  wallets          Wallet[]
  transactions     Transaction[]
  semesterFees     SemesterFee[]
  libraryFines     LibraryFine[]
  adminFines       AdminFine[]
  adminFinesIssued AdminFine[]   @relation("AdminFineIssuedBy")
  payLaterDues     PayLaterDue[]
  otpCodes         OtpCode[]
  auditLogs        AuditLog[]
  shop             Shop?

  // Financial Dispute & Case Management System
  receivedTransactions       Transaction[]          @relation("TransactionReceiver")
  disputesRaised             Dispute[]              @relation("DisputeRaisedBy")
  disputesAssigned           Dispute[]              @relation("DisputeAssignedTo")
  disputeMessages            DisputeMessage[]
  disputeAttachments         DisputeAttachment[]
  disputeAssignmentsReceived DisputeAssignment[]    @relation("DisputeAssignmentAssignedTo")
  disputeAssignmentsMade     DisputeAssignment[]    @relation("DisputeAssignmentAssignedBy")
  refundsInitiated           Refund[]
  refundApprovals            RefundApproval[]
  disputeTimelineEvents      DisputeTimeline[]
  disputeStatusChanges       DisputeStatusHistory[]
  disputeNotifications       DisputeNotification[]
  notifications              Notification[]

  // Fee Management Workflow
  feeBatchesMaker    SemesterFeeBatch[]      @relation("FeeBatchMaker")
  feeBatchesChecker  SemesterFeeBatch[]      @relation("FeeBatchChecker")
  feeBatchesApprover SemesterFeeBatch[]      @relation("FeeBatchApprover")
  feeImports         SemesterFeeImport[]
  feeInvoices        FeeInvoice[]
  paymentRequests    PaymentRequest[]
  gatewaySessions    PaymentGatewaySession[]
  ledgerEntries      LedgerEntry[]
}

model Wallet {
  id                 String   @id @default(cuid())
  walletId           String   @unique
  owner              User     @relation(fields: [ownerId], references: [id])
  ownerId            String
  balance            Float    @default(0)
  dailyTransferLimit Float    @default(10000)
  dailyTransferred   Float    @default(0)
  lastTransferDate   String?
  frozen             Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Transaction {
  id             String   @id @default(cuid())
  reference      String   @unique
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  type           String
  direction      String
  amount         Float
  serviceCharge  Float?   @default(0)
  status         String   @default("Pending")
  shop           Shop?    @relation(fields: [shopId], references: [id])
  shopId         String?
  gateway        String?
  gatewayTxnId   String?
  bankTxnId      String?  @unique
  idempotencyKey String?
  description    String?
  paymentMethod  String?
  purpose        String?
  itemsJson      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  callbacks PaymentCallback[]

  // Financial Dispute & Case Management System — additive audit-context columns.
  // All nullable: populated going forward at each money-movement call site; historical rows
  // predating this simply have no value here (never backfilled/fabricated).
  receiver                   User?   @relation("TransactionReceiver", fields: [receiverId], references: [id])
  receiverId                 String?
  receiverRoleSnapshot       String?
  receiverDepartmentSnapshot String?
  balanceBefore              Float?
  balanceAfter               Float?
  ipAddress                  String?
  deviceInfo                 String?

  disputes          Dispute[]
  refundsAsOriginal Refund[]  @relation("RefundOriginalTransaction")
  refundReversalFor Refund?   @relation("RefundReversalTransaction")
}

model PaymentCallback {
  id            String       @id @default(cuid())
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  transactionId String?
  reference     String
  source        String
  rawPayload    String
  sslStatus     String?
  verified      Boolean      @default(false)
  ipAddress     String?
  createdAt     DateTime     @default(now())
}

model Shop {
  id             String   @id @default(cuid())
  name           String
  category       String
  rating         Float    @default(0)
  status         String   @default("Active")
  qrToken        String?
  qrSignature    String?
  location       String?
  logoUrl        String?
  merchantId     String?  @unique
  flagged        Boolean  @default(false)
  // Real merchant login — nullable only until every existing Shop row is backfilled with an
  // owner account (see server/src/backfill-shop-owners.ts), then tightened to required.
  ownerId        String?  @unique
  owner          User?    @relation(fields: [ownerId], references: [id])
  contactNumber  String?
  ownerName      String?
  description    String?
  operatingHours String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions      Transaction[]
  payLaterDues      PayLaterDue[]
  settlements       Settlement[]
  forwardedDisputes Dispute[]     @relation("DisputeForwardedShop")
}

// Records a manual internal reconciliation — Admin Office confirming a shop's collected
// SSLCommerz revenue has been paid out to that shop outside the app. SSLCommerz doesn't expose
// an API for actual bank disbursement, so this is bookkeeping, not automatic — every row here
// IS the settlement history (append-only, never edited), so no separate history table is needed.
model Settlement {
  id        String   @id @default(cuid())
  shop      Shop     @relation(fields: [shopId], references: [id])
  shopId    String
  amount    Float
  notes     String?
  settledBy String?
  settledAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model SemesterFee {
  id        String   @id @default(cuid())
  label     String?
  student   User     @relation(fields: [studentId], references: [id])
  studentId String
  amount    Float
  dueDate   String?
  status    String   @default("Pending")
  reference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, status])
}

// Singleton-style entity for the Library's permanent QR/identity — unlike Shop, Library Staff
// accounts share ONE Library record (matches the existing shared fine-queue dashboard model,
// no per-staff ownership/isolation). ensureLibrarySingleton() in libraryService.ts creates the
// one row on first access.
model Library {
  id             String   @id @default(cuid())
  name           String   @default("Central Library")
  status         String   @default("Active")
  qrToken        String?
  qrSignature    String?
  location       String?
  logoUrl        String?
  libraryCode    String?  @unique
  contactNumber  String?
  description    String?
  operatingHours String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Singleton-style entity for Accounts Office's permanent QR/identity — mirrors the Library
// singleton pattern (one shared record for every Accounts Office staff account, no per-staff
// isolation). ensureAccountsOfficeSingleton() in accountsService.ts creates the one row on first
// access via a fixed-id upsert (avoids the TOCTOU race the Library singleton originally hit).
model AccountsOffice {
  id          String   @id @default("singleton-accounts")
  name        String   @default("Accounts Office")
  qrToken     String?
  qrSignature String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LibraryFine {
  id        String   @id @default(cuid())
  label     String?
  student   User     @relation(fields: [studentId], references: [id])
  studentId String
  fineType  String?
  amount    Float
  dueDate   String?
  status    String   @default("Pending")
  reference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, status])
}

model AdminFine {
  id             String    @id @default(cuid())
  reason         String?
  student        User      @relation(fields: [studentId], references: [id])
  studentId      String
  amount         Float
  incidentDate   String?
  status         String    @default("Pending") // Pending, Disputed, Paid, Waived, Cancelled
  reference      String?
  // Admin Office issues fines only — it is never the payment receiver. These fields track who
  // issued/cancelled/reconciled the fine for audit purposes; Accounts Office is the sole financial
  // authority that collects and reconciles payment (see AccountsOffice model below).
  issuedBy       User?     @relation("AdminFineIssuedBy", fields: [issuedById], references: [id])
  issuedById     String?
  cancelledAt    DateTime?
  cancelledById  String?
  reconciledAt   DateTime?
  reconciledById String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([studentId, status])
}

model PayLaterDue {
  id               String   @id @default(cuid())
  reference        String?
  student          User     @relation(fields: [studentId], references: [id])
  studentId        String
  shop             Shop     @relation(fields: [shopId], references: [id])
  shopId           String
  amount           Float
  status           String   @default("Pending")
  dueDate          String?
  description      String?
  paymentReference String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([studentId, status])
}

model OtpCode {
  id        String    @id @default(cuid())
  code      String
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?
  purpose   String
  status    String    @default("Active")
  attempts  Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  actor      User?    @relation(fields: [actorId], references: [id])
  actorId    String?
  entityType String?
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

// ─── FINANCIAL DISPUTE & CASE MANAGEMENT SYSTEM ───
//
// Covers every payment source in the platform (wallet transfer/top-up/withdrawal, semester fee,
// library fine, admin fine, shop QR payment, SSLCommerz, and future payment modules) via a single
// dispute-per-transaction model. Deliberately does NOT add a separate "DisputeAudit" table — the
// existing AuditLog above already serves that purpose platform-wide (entityType: "Dispute"), so
// there is one immutable security audit trail instead of two competing ones. DisputeTimeline
// (human-readable case narrative) and DisputeStatusHistory (strict status transitions) remain
// distinct because they serve different UI/reporting needs than a security audit log does.
// Every status field is a plain String (matching every other model in this schema, none of which
// use a native Prisma enum) — valid values are enforced as TS union types in the application code.
// Nothing here is ever hard-deleted: closing/rejecting/merging a case is a status change, not a
// row deletion; Dispute.deletedAt exists only for an explicit soft-delete of a case raised in
// error, never used for normal case resolution.

model Dispute {
  id            String      @id @default(cuid())
  caseNumber    String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  transactionId String
  raisedBy      User        @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  raisedById    String
  category      String
  description   String
  status        String      @default("Open")
  assignedTo    User?       @relation("DisputeAssignedTo", fields: [assignedToId], references: [id])
  assignedToId  String?
  priority      String      @default("Normal")
  riskScore     Float?
  slaDueAt      DateTime?
  frozen        Boolean     @default(false)
  frozenAt      DateTime?
  mergedInto    Dispute?    @relation("DisputeMerge", fields: [mergedIntoId], references: [id])
  mergedIntoId  String?
  mergedCases   Dispute[]   @relation("DisputeMerge")
  splitFrom     Dispute?    @relation("DisputeSplit", fields: [splitFromId], references: [id])
  splitFromId   String?
  splitCases    Dispute[]   @relation("DisputeSplit")
  resolvedAt    DateTime?
  closedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // ─── Routing/ownership (added for the forward-to-specific-shop and return-routing fix) ───
  // Which shop a "Forward to Shop" targeted, when there's more than one active shop — the status
  // string (WaitingForShop) alone can't disambiguate which shop's staff should see the case.
  forwardedShop   Shop?   @relation("DisputeForwardedShop", fields: [forwardedShopId], references: [id])
  forwardedShopId String?
  // Who forwarded the case most recently (role + user snapshot), so that when Shop/Library
  // finishes reviewing, the case returns to whoever actually sent it (Accounts or Admin) instead
  // of a hardcoded destination.
  forwardedByRole String?
  forwardedById   String?
  // Which Admin has claimed/actioned this case — backs the Admin dashboard's "My Cases" filter.
  // Separate from assignedToId, which is Accounts-only (see DisputeAssignment/staff-performance).
  adminOwnerId    String?

  messages      DisputeMessage[]
  attachments   DisputeAttachment[]
  assignments   DisputeAssignment[]
  refunds       Refund[]
  timeline      DisputeTimeline[]
  statusHistory DisputeStatusHistory[]
  notifications DisputeNotification[]
}

model DisputeMessage {
  id         String   @id @default(cuid())
  dispute    Dispute  @relation(fields: [disputeId], references: [id])
  disputeId  String
  author     User     @relation(fields: [authorId], references: [id])
  authorId   String
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  attachments DisputeAttachment[]
}

// Real validation today (magic-byte sniffing, extension allowlist, size caps) plus a pluggable
// async scan-hook (scanStatus) ready for a real AV engine — no such engine is provisioned in this
// project, so nothing marks a file "clean" without a real scan actually having run.
model DisputeAttachment {
  id           String          @id @default(cuid())
  dispute      Dispute         @relation(fields: [disputeId], references: [id])
  disputeId    String
  message      DisputeMessage? @relation(fields: [messageId], references: [id])
  messageId    String?
  uploadedBy   User            @relation(fields: [uploadedById], references: [id])
  uploadedById String
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  sha256       String
  scanStatus   String          @default("pending")
  scannedAt    DateTime?
  createdAt    DateTime        @default(now())
}

// Append-only assignment history. The *current* assignee lives on Dispute.assignedToId; this
// table is the immutable trail of every assignment/reassignment for audit purposes.
model DisputeAssignment {
  id           String   @id @default(cuid())
  dispute      Dispute  @relation(fields: [disputeId], references: [id])
  disputeId    String
  assignedTo   User     @relation("DisputeAssignmentAssignedTo", fields: [assignedToId], references: [id])
  assignedToId String
  assignedBy   User     @relation("DisputeAssignmentAssignedBy", fields: [assignedById], references: [id])
  assignedById String
  note         String?
  createdAt    DateTime @default(now())
}

model Refund {
  id                    String       @id @default(cuid())
  dispute               Dispute      @relation(fields: [disputeId], references: [id])
  disputeId             String
  transaction           Transaction  @relation("RefundOriginalTransaction", fields: [transactionId], references: [id])
  transactionId         String
  method                String
  amountType            String
  amount                Float
  status                String       @default("Pending")
  initiatedBy           User         @relation(fields: [initiatedById], references: [id])
  initiatedById         String
  // The new Transaction row created to actually move money back (wallet credit / reversal) once
  // the refund is processed — null until then. Reusing the guarded $transaction pattern from
  // /semester-fees/pay, never a bypass of the ledger.
  reversalTransaction   Transaction? @relation("RefundReversalTransaction", fields: [reversalTransactionId], references: [id])
  reversalTransactionId String?      @unique
  notes                 String?
  createdAt             DateTime     @default(now())
  processedAt           DateTime?

  approvals RefundApproval[]
}

// High-value refunds require a secondary sign-off beyond the Accounts Officer who initiated it
// (Admin approval) — every decision on that approval chain is recorded here, never overwritten.
model RefundApproval {
  id         String   @id @default(cuid())
  refund     Refund   @relation(fields: [refundId], references: [id])
  refundId   String
  approver   User     @relation(fields: [approverId], references: [id])
  approverId String
  decision   String
  notes      String?
  decidedAt  DateTime @default(now())
}

// The human-readable event feed rendered as "Audit Timeline" on both the student's transaction
// card and the staff case-detail view — distinct from AuditLog (security trail) and
// DisputeStatusHistory (strict status transitions only).
model DisputeTimeline {
  id           String   @id @default(cuid())
  dispute      Dispute  @relation(fields: [disputeId], references: [id])
  disputeId    String
  eventType    String
  actor        User?    @relation(fields: [actorId], references: [id])
  actorId      String?
  summary      String
  metadataJson String?
  createdAt    DateTime @default(now())
}

model DisputeStatusHistory {
  id          String   @id @default(cuid())
  dispute     Dispute  @relation(fields: [disputeId], references: [id])
  disputeId   String
  fromStatus  String
  toStatus    String
  changedBy   User     @relation(fields: [changedById], references: [id])
  changedById String
  reason      String?
  createdAt   DateTime @default(now())
}

// Scoped to dispute events only (case updates, replies, refund processed/rejected, documents
// requested) — the existing ad-hoc /notifications feed (Transaction/SemesterFee/LibraryFine
// derived) is untouched and unrelated to this table.
model DisputeNotification {
  id          String    @id @default(cuid())
  dispute     Dispute?  @relation(fields: [disputeId], references: [id])
  disputeId   String?
  recipient   User      @relation(fields: [recipientId], references: [id])
  recipientId String
  type        String
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
}

// General-purpose, persisted notification feed covering every non-dispute event platform-wide
// (wallet top-up/withdraw/transfer, shop/semester-fee/library-fine payments, security events like
// PIN/password changes, admin actions, etc.) — DisputeNotification above remains the dedicated
// table for dispute-case events; the /notifications endpoint merges both into one feed per user.
model Notification {
  id          String    @id @default(cuid())
  recipient   User      @relation(fields: [recipientId], references: [id])
  recipientId String
  category    String
  type        String
  title       String
  body        String
  link        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, createdAt])
}

// Atomic case-number generator (DSP-2026-000125): a single upsert with `value: {increment: 1}`
// compiles to one atomic UPDATE, safe under concurrent filers without any new infra (no Redis,
// no DB sequence object needed).
model SequenceCounter {
  id    String @id
  value Int    @default(0)
}

// ─── FEE MANAGEMENT WORKFLOW MODELS ───

model SemesterFeeBatch {
  id            String @id @default(cuid())
  batchNumber   String @unique
  department    String
  program       String
  semester      String
  academicYear  String
  label         String
  status        String @default("Draft") // Draft, Validated, PendingApproval, Approved, Rejected, Pushed
  totalRows     Int    @default(0)
  validRows     Int    @default(0)
  invalidRows   Int    @default(0)
  duplicateRows Int    @default(0)
  totalAmount   Float  @default(0)

  makerId    String
  maker      User    @relation("FeeBatchMaker", fields: [makerId], references: [id])
  checkerId  String?
  checker    User?   @relation("FeeBatchChecker", fields: [checkerId], references: [id])
  approverId String?
  approver   User?   @relation("FeeBatchApprover", fields: [approverId], references: [id])

  rejectionReason String?
  approvedAt      DateTime?
  pushedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  imports  SemesterFeeImport[]
  items    SemesterFeeItem[]
  pushJobs FeePushJob[]
}

model SemesterFeeImport {
  id           String           @id @default(cuid())
  batchId      String
  batch        SemesterFeeBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  fileName     String
  fileType     String           @default("excel")
  uploadedById String
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime         @default(now())
}

model SemesterFeeItem {
  id                   String           @id @default(cuid())
  batchId              String
  batch                SemesterFeeBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId            String
  studentName          String
  studentEmail         String
  department           String
  program              String
  credit               Float            @default(0)
  tuition              Float            @default(0)
  waiver               Float            @default(0)
  waiverAdjustment     Float            @default(0)
  lateFee              Float            @default(0)
  finalAmount          Float            @default(0)
  dueDate              String?
  feeLabel             String?
  remark               String?
  status               String           @default("Valid") // Valid, Invalid, Duplicate, Pushed, Error
  validationErrorsJson String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  invoices FeeInvoice[]
}

model FeePushJob {
  id             String           @id @default(cuid())
  batchId        String
  batch          SemesterFeeBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  status         String           @default("Pending") // Pending, Processing, Completed, Failed
  processedCount Int              @default(0)
  totalCount     Int              @default(0)
  errorLog       String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
}

model FeeInvoice {
  id            String           @id @default(cuid())
  invoiceNumber String           @unique
  batchItemId   String?
  batchItem     SemesterFeeItem? @relation(fields: [batchItemId], references: [id])
  studentId     String
  student       User             @relation(fields: [studentId], references: [id])
  amount        Float
  feeLabel      String
  dueDate       String?
  pdfUrl        String?
  status        String           @default("Unpaid") // Unpaid, Paid, Cancelled
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  paymentRequests PaymentRequest[]
  ledgerEntries   LedgerEntry[]
}

model PaymentRequest {
  id         String      @id @default(cuid())
  requestRef String      @unique
  invoiceId  String?
  invoice    FeeInvoice? @relation(fields: [invoiceId], references: [id])
  studentId  String
  student    User        @relation(fields: [studentId], references: [id])
  amount     Float
  status     String      @default("Pending") // Pending, Processing, Completed, Expired, Failed
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  gatewaySessions PaymentGatewaySession[]
  statusHistory   PaymentStatusHistory[]
}

model PaymentGatewaySession {
  id               String          @id @default(cuid())
  sessionKey       String          @unique
  paymentRequestId String?
  paymentRequest   PaymentRequest? @relation(fields: [paymentRequestId], references: [id])
  studentId        String
  student          User            @relation(fields: [studentId], references: [id])
  amount           Float
  feeLabel         String
  gateway          String          @default("SSLCommerz") // SSLCommerz, Stripe, Braintree, ManualBank, Wallet
  status           String          @default("Active") // Active, Completed, Cancelled, Expired
  gatewayUrl       String?
  expiresAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model PaymentStatusHistory {
  id               String         @id @default(cuid())
  paymentRequestId String
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  fromStatus       String
  toStatus         String
  notes            String?
  createdAt        DateTime       @default(now())
}

model LedgerEntry {
  id           String      @id @default(cuid())
  entryNumber  String      @unique
  studentId    String?
  student      User?       @relation(fields: [studentId], references: [id])
  invoiceId    String?
  invoice      FeeInvoice? @relation(fields: [invoiceId], references: [id])
  type         String // DEBIT_DUE, CREDIT_PAYMENT, WAIVER_ADJUSTMENT, REFUND
  debitAmount  Float       @default(0)
  creditAmount Float       @default(0)
  balanceAfter Float       @default(0)
  reference    String?
  description  String?
  createdAt    DateTime    @default(now())
}
